7a:["$","p","p-48",{"children":["Ensure ",["$","pre","code-0",{"children":["$","code",null,{"children":"playwright/.auth/login.json"}]}]," exists (created by the CI mock auth step or manually as ",["$","pre","code-1",{"children":["$","code",null,{"children":"{}"}]}],"). The API client requires Backstage identity credentials."]}]
