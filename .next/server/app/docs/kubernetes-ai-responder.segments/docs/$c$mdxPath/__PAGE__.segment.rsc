73:["$","p","p-43",{"children":["The deterministic classifier checks only container termination reasons, rollout conditions, and restart counts. If a pod is failing for a reason not covered by these patterns (e.g., a readiness probe timeout with no terminated containers), the class will be ",["$","pre","code-0",{"children":["$","code",null,{"children":"unknown"}]}],". This is a handled state — evidence is still collected (workload events), and the model synthesizes a report from whatever diagnostics were gathered."]}]
74:["$","p","p-44",{"children":["$","strong","strong-0",{"children":"No log excerpts in the evidence bundle for a crashed container"}]}]
75:["$","p","p-45",{"children":["Previous-container logs are only collected when the evidence plan for the failure class enables them (",["$","pre","code-0",{"children":["$","code",null,{"children":"oom-killed"}]}]," and ",["$","pre","code-1",{"children":["$","code",null,{"children":"crash-loop"}]}],"). For ",["$","pre","code-2",{"children":["$","code",null,{"children":"image-pull"}]}],", ",["$","pre","code-3",{"children":["$","code",null,{"children":"rollout-exceeded"}]}],", and ",["$","pre","code-4",{"children":["$","code",null,{"children":"unknown"}]}]," classes, logs are skipped because the failure is either pre-startup or infrastructure-level. Additionally, the ",["$","pre","code-5",{"children":["$","code",null,{"children":"maxLogContainers"}]}]," cap (default 3) limits how many containers per pod have their logs pulled."]}]
76:["$","p","p-46",{"children":["$","strong","strong-0",{"children":"LLM rate limits or context window overruns"}]}]
77:["$","ul","ul-10",{"children":["\n",["$","li","li-0",{"children":["Reduce ",["$","pre","code-0",{"children":["$","code",null,{"children":"maxEvidenceItems"}]}]," to present fewer evidence items to the model"]}],"\n",["$","li","li-1",{"children":["Reduce ",["$","pre","code-0",{"children":["$","code",null,{"children":"maxLogBytes"}]}]," to cap individual log excerpts smaller"]}],"\n",["$","li","li-2",{"children":["Reduce ",["$","pre","code-0",{"children":["$","code",null,{"children":"maxToolInvocations"}]}]," to cap the diagnostic budget per investigation"]}],"\n",["$","li","li-3",{"children":["The system prompt is compact, evidence summaries are capped at 1024 characters, and logs are bounded at ",["$","pre","code-0",{"children":["$","code",null,{"children":"maxLogBytes"}]}]," — the total prompt size is bounded"]}],"\n"]}]
