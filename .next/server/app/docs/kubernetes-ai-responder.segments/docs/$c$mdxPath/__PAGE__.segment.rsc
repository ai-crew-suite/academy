85:["$","ul","ul-11",{"children":["\n",["$","li","li-0",{"children":[["$","strong","strong-0",{"children":"VCS change context"}]," — correlate recent pull requests and commits against the incident window via ",["$","pre","code-0",{"children":["$","code",null,{"children":"vcs.pull_request.list"}]}],", helping identify whether a recent deploy or configuration change triggered the failure"]}],"\n",["$","li","li-1",{"children":[["$","strong","strong-0",{"children":"Observability evidence"}]," — pull related logs, traces, and dashboard links via ",["$","pre","code-0",{"children":["$","code",null,{"children":"observability.logs.search"}]}]," and ",["$","pre","code-1",{"children":["$","code",null,{"children":"observability.dashboard.list"}]}]," for correlated diagnostic context"]}],"\n",["$","li","li-2",{"children":[["$","strong","strong-0",{"children":"Incident management context"}]," — correlate active incidents and alert history via ",["$","pre","code-0",{"children":["$","code",null,{"children":"incident.incident.list"}]}]," to establish whether the failure is part of a broader incident"]}],"\n",["$","li","li-3",{"children":[["$","strong","strong-0",{"children":"Knowledge retrieval"}]," — entity-scoped RAG documentation context via ",["$","pre","code-0",{"children":["$","code",null,{"children":"knowledge.retrieve"}]}]," to surface runbooks and operational playbooks in the report"]}],"\n"]}]
