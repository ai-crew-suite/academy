8d:["$","ul","ul-14",{"children":["\n",["$","li","li-0",{"children":"Usage dashboards tracking investigation volume, failure-class distribution, tool invocation counts, and model latency/token cost"}],"\n",["$","li","li-1",{"children":"An opt-in real-model evaluation harness that compares model-authored causes against a curated corpus of known-failure-class fixture data with verified root causes"}],"\n",["$","li","li-2",{"children":["Evidence-completeness monitoring: track which failure classes most often produce ",["$","pre","code-0",{"children":["$","code",null,{"children":"insufficient_evidence"}]}],", indicating missing driver coverage"]}],"\n"]}]
