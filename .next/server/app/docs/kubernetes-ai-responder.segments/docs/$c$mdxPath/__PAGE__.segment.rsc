"}],["$","td","td-3",{"children":"✅ Workload events"}],["$","td","td-4",{"children":"✅ Deployment timeline"}]]}],["$","tr","tr-4",{"children":[["$","td","td-0",{"children":["$","strong","strong-0",{"children":"unknown"}]}],["$","td","td-1",{"children":"No recognized failure pattern"}],["$","td","td-2",{"children":"—"}],["$","td","td-3",{"children":"✅ Workload events"}],["$","td","td-4",{"children":"—"}]]}]]}]]}]
