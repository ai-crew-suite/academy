87:["$","ul","ul-12",{"children":["\n",["$","li","li-0",{"children":"Post investigation results to incident channels (Slack, PagerDuty, project management tools) when a triage report identifies a likely cause above a configurable confidence threshold"}],"\n",["$","li","li-1",{"children":["Auto-escalate investigations with ",["$","pre","code-0",{"children":["$","code",null,{"children":"insufficient_evidence"}]}]," to an on-call responder with the collected evidence bundle"]}],"\n",["$","li","li-2",{"children":"Notification content remains bounded, redacted, and never includes raw log content or secrets"}],"\n"]}]
