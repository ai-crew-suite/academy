53:["$","table","table-1",{"children":[["$","thead","thead-0",{"children":["$","tr","tr-0",{"children":[["$","th","th-0",{"children":"Step"}],["$","th","th-1",{"children":"Source"}],["$","th","th-2",{"children":"Behaviour and termination"}]]}]}],["$","tbody","tbody-0",{"children":[["$","tr","tr-0",{"children":[["$","td","td-0",{"children":["$","strong","strong-0",{"children":"observe"}]}],["$","td","td-1",{"children":["$","pre","code-0",{"children":["$","code",null,{"className":"$undefined","children":"history.ts"}]}]}],["$","td","td-2",{"children":["Reads alert firing history via ",["$","pre","code-0",{"children":["$","code",null,{"className":"$undefined","children":"incident.alert.history"}]}],"; derives durations from trigger/resolve timestamps; window-clamps and deduplicates newest-first. ",["$","strong","strong-0",{"children":"Evidence floor check"}],": if the resulting sample count is below ",["$","pre","code-1",{"children":["$","code",null,{"className":"$undefined","children":"noise.minSamples"}]}],", the run emits ",["$","pre","code-2",{"children":["$","code",null,{"className":"$undefined","children":"insufficient_evidence"}]}]," immediately — before any model call or repository read."]}]]}],["$","tr","tr-1",{"children":[["$","td","td-0",{"children":["$","strong","strong-0",{"children":"analyze"}]}],["$","td","td-1",{"children":["$","pre","code-0",{"children":["$","code",null,{"className":"$undefined","children":"noise.ts"}]}]}],["$","td","td-2",{"children":["Computes the deterministic ",["$","pre","code-0",{"children":["$","code",null,{"className":"$undefined","children":"NoiseScore"}]}]," from normalized ",["$","pre","code-1",{"children":["$","code",null,{"className":"$undefined","children":"FiringSample[]"}]}]," using nearest-rank percentiles (median, p90). The model is never consulted here; the verdict is fixed in pure arithmetic."]}]]}],["$","tr","tr-2",{"children":[["$","td","td-0",{"children":["$","strong","strong-0",{"children":"correlate"}]}],["$","td","td-1",{"children":["$","pre","code-0",{"children":["$","code",null,{"className":"$undefined","children":"correlate.ts"}]}]}],["$","td","td-2",{"children":["Reads real incidents via ",["$","pre","code-0",{"children":["$","code",null,{"className":"$undefined","children":"incident.incident.list"}]}],", normalizes them into padded ",["$","pre","code-1",{"children":["$","code",null,{"className":"$undefined","children":"SuppressionWindow[]"}]}],", and tests each firing for interval overlap. Any overlap forces ",["$","pre","code-2",{"children":["$","code",null,{"className":"$undefined","children":"verdict: 'real_signal'"}]}]," — a terminal outcome that removes the patch path entirely. Entries with ",["$","pre","code-3",{"children":["$","code",null,{"className":"$undefined","children":"resolution: 'unresolved'"}]}]," participate in correlation but not in duration statistics."]}]]}],["$","tr","tr-3",{"children":[["$","td","td-0",{"children":["$","strong","strong-0",{"children":"locate"}]}],["$","td","td-1",{"children":[["$","pre","code-0",{"children":["$","code",null,{"className":"$undefined","children":"pipeline.ts"}]}]," (orchestrating ",["$","pre","code-1",{"children":["$","code",null,{"className":"$undefined","children":"locate.ts"}]}]," + ",["$","pre","code-2",{"children":["$","code",null,{"className":"$undefined","children":"patch.ts"}]}]," + ",["$","pre","code-3",{"children":["$","code",null,{"className":"$undefined","children":"proposal.ts"}]}],")"]}],["$","td","td-2",{"children":["Resolves the owning IaC file via ",["$","pre","code-0",{"children":["$","code",null,{"className":"$undefined","children":"vcs.repository.search"}]}]," / ",["$","pre","code-1",{"children":["$","code",null,{"className":"$undefined","children":"vcs.repository.read_file"}]}],", discovers the exact ",["$","pre","code-2",{"children":["$","code",null,{"className":"$undefined","children":"ThresholdAnchor"}]}]," with line numbers (HCL ",["$","pre","code-3",{"children":["$","code",null,{"classN