20:["$","p","p-5",{"children":["The graph runs as a custom ",["$","pre","code-0",{"children":["$","code",null,{"className":"$undefined","children":"WorkflowRunner"}]}]," at ID ",["$","pre","code-1",{"children":["$","code",null,{"className":"$undefined","children":"alert-tuning"}]}],", executing a fixed pipeline: ",["$","pre","code-2",{"children":["$","code",null,{"className":"$undefined","children":"observe → analyze → correlate → locate → patch → alert-tuning-proposal"}]}],". The proposal artifact carries the complete evidence bundle so the reviewer sees every cited ",["$","pre","code-3",{"children":["$","code",null,{"className":"$undefined","children":"fire-N"}]}],", ",["$","pre","code-4",{"children":["$","code",null,{"className":"$undefined","children":"inc-N"}]}],", and ",["$","pre","code-5",{"children":["$","code",null,{"className":"$undefined","children":"iac-N"}]}]," reference behind the recommendation."]}]
