5:["$","pre","pre-3",{"children":["$","pre","code-0",{"children":["$","code",null,{"className":"language-bash","children":"helm repo add ai-crew-suite https://webstackbuilders.github.io/ai-crew-suite-helm\nhelm repo update\n"}]}]}]
