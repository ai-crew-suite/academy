3a:["$","p","p-14",{"children":"Adding plugin-scoped memory to your own Backstage plugin:"}]
3b:["$","pre","pre-5",{"children":["$","pre","code-0",{"children":["$","code",null,{"className":"language-typescript","children":"import { createPluginWithMemory } from \"@webstackbuilders/plugin-ai-core\";\n\nexport const myPlugin = createPluginWithMemory({\n  id: \"my-plugin\",\n  memoryConfig: {\n    maxSize: 1024 * 1024, // 1MB\n    ttlSeconds: 3600, // 1 hour\n    persistence: \"redis\", // or \"memory\", \"postgres\"\n  },\n  workflow: async ({ memory, context }) => {\n    // Store evidence\n    await memory.set(\"evidence\", context.evidence);\n\n    // Retrieve later\n    const storedEvidence = await memory.get(\"evidence\");\n\n    return { findings: storedEvidence };\n  },\n});\n"}]}]}]
3c:["$","h2","h2-7",{"id":"next-steps","children":"Next Steps"}]
3d:["$","p","p-15",{"children":"Plugin-scoped automation is just one of the architectural patterns in AI Crew Suite. In future posts, we'll cover:"}]
3e:["$","ul","ul-4",{"children":["\n",["$","li","li-0",{"children":[["$","strong","strong-0",{"children":"Evidence Collection Patterns"}]," - Bounded, cited, verifiable data gathering"]}],"\n",["$","li","li-1",{"children":[["$","strong","strong-0",{"children":"Tool Selection Algorithms"}]," - Programmatic tool choice without LLMs"]}],"\n",["$","li","li-2",{"children":[["$","strong","strong-0",{"children":"Safety Gates"}]," - Human approval workflows for dangerous operations"]}],"\n"]}]
3f:["$","p","p-16",{"children":["Check out our ",["$","$L13","a-0",{"href":"/docs/developer-guide","children":"Developer Guide"}]," to start building your own plugin-scoped automations."]}]
