{
  "name": "@ai-crew-suite/academy",
  "description": "Documentation and tutorial website for AI Crew Suite",
  "private": true,
  "engines": {
    "node": ">=24.8.0",
    "npm": "Please use Yarn instead (Corepack enable)"
  },
  "packageManager": "yarn@4.18.0",
  "scripts": {
    "dev": "next dev",
    "dev:webpack": "next dev --webpack",
    "build": "next build",
    "postbuild": "next-sitemap --config sitemap.config.mjs",
    "start": "next start",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "npm run lint:code && npm run lint:style",
    "lint:code": "eslint . --max-warnings=0",
    "lint:style": "stylelint \"styles/**/*.css\"",
    "lint:fix": "npm run lint:code:fix && npm run lint:style:fix",
    "lint:code:fix": "eslint . --fix",
    "lint:style:fix": "stylelint \"styles/**/*.css\" --fix",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@heroicons/react": "catalog:prod",
    "@microsoft/clarity": "catalog:prod",
    "@next/third-parties": "catalog:prod",
    "@portabletext/markdown": "catalog:prod",
    "@portabletext/react": "catalog:prod",
    "@radix-ui/react-slot": "catalog:prod",
    "@sentry/nextjs": "catalog:prod",
    "@tailwindcss/forms": "catalog:prod",
    "@tailwindcss/typography": "catalog:prod",
    "class-variance-authority": "catalog:prod",
    "clsx": "catalog:prod",
    "embla-carousel-autoplay": "catalog:prod",
    "embla-carousel-react": "catalog:prod",
    "gray-matter": "catalog:prod",
    "logrocket": "catalog:prod",
    "lucide-react": "catalog:prod",
    "next": "catalog:prod",
    "next-sanity": "catalog:prod",
    "nextra": "catalog:prod",
    "nextra-theme-docs": "catalog:prod",
    "postcss": "catalog:prod",
    "react": "catalog:prod",
    "react-dom": "catalog:prod",
    "react-hook-form": "catalog:prod",
    "react-markdown": "catalog:prod",
    "remark-gfm": "catalog:prod",
    "tailwind-merge": "catalog:prod",
    "three": "catalog:prod"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "catalog:dev",
    "@testing-library/dom": "catalog:dev",
    "@testing-library/jest-dom": "catalog:dev",
    "@testing-library/react": "catalog:dev",
    "@testing-library/user-event": "catalog:dev",
    "@types/mdx": "catalog:dev",
    "@types/node": "catalog:dev",
    "@types/react": "catalog:dev",
    "@types/react-dom": "catalog:dev",
    "@types/three": "catalog:dev",
    "babel-plugin-react-compiler": "catalog:dev",
    "eslint": "catalog:dev",
    "eslint-config-next": "catalog:dev",
    "jsdom": "catalog:dev",
    "next-sitemap": "catalog:dev",
    "prettier": "catalog:dev",
    "stylelint": "catalog:dev",
    "stylelint-config-standard": "catalog:dev",
    "tailwindcss": "catalog:dev",
    "tw-animate-css": "catalog:dev",
    "typescript": "catalog:dev",
    "vite": "catalog:dev",
    "vitest": "catalog:dev"
  }
}
