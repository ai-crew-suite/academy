{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@ai-crew-suite/typescript-shared-config/node",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    "**/*.mts",
    "next.config.ts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": ["node_modules"],
  "plugins": [
    {
      "name": "next"
    }
  ],
}
